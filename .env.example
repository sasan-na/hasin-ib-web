# Copy to `.env.local` for local development. All variables are exposed to the client at build time.

# Legacy server API root (Initialize, Login2, TwoFactorLogin ...). Defaults to same-origin "/api".
# VITE_API_URL=https://ib.radin.tech/api

# Dev only: the dev server forwards same-origin /api calls to this server (it sends no CORS headers), so
# the app talks to the real backend. Leave VITE_API_URL unset when using it.
VITE_DEV_PROXY_TARGET=https://ib.radin.tech

# Where password recovery lives. The sign-in page hides its link while this is unset.
# VITE_PASSWORD_RECOVERY_URL=https://recovery.example.com

# Where facilities can be received online. The credit calculator hides its link while this is unset.
# VITE_FACILITY_URL=https://ecounter.bank-maskan.ir/loans/facility

# Minimum log level for src/lib/logger.ts: debug | info | warn | error | silent (dev: debug, prod: warn).
# VITE_LOG_LEVEL=debug

# Where customers download the signing service for their token (used by the in-branch services that sign a PDF here).
# The link is hidden while this is unset.
# VITE_SIGN_APP_DOWNLOAD_URL=https://download.bank-maskan.ir/installer.exe

# dev only: serve over https (self-signed) so the login works from another device on the network
# VITE_DEV_HTTPS=1
